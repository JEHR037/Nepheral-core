{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nepheral",
  "version": "0.5.4",
  "identifier": "net.nepheral.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../LICENSE": "legal/LICENSE",
      "../legal/": "legal/"
    },
    "publisher": "Nepheral",
    "category": "Utility",
    "shortDescription": "Private AI on a peer-to-peer network",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExNjlDMUY1Rjg1NUNCMEEKUldRS3kxWDQ5Y0Zwb1lDQVpJY3hGelZUZmFBTkFJWnBmV1dJeGNQWDA3RjMyaWVVWENFNU1SQnYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
